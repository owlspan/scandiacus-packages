// vulkan - Vulkan on a win window.
//
//     veyl get vulkan
//
//     import "vulkan"
//
//     let w = must(win.open("cube", 800, 600))
//     let v = must(vkOpen(w))
//     let pipe = must(vkPipeline(v, must(bytes.read("cube.vert.spv")),
//         must(bytes.read("cube.frag.spv")), [3, 3], 64))
//     let mesh = must(vkVertices(v, vertices))
//     while win.poll(w) {
//         if vkBegin(v, 0.1, 0.1, 0.15) {
//             vkBind(v, pipe)
//             vkPush(v, pipe, mvp)
//             vkDraw(v, mesh, 36)
//             vkEnd(v)
//         }
//     }
//     vkClose(v)
//
// What vkOpen sets up is the part every Vulkan program writes the same
// way: an instance, a surface on the window, a device and queue that
// can draw and present, a swapchain with vsync, a depth buffer, a
// render pass that clears both, and two frames in flight. The rest of
// the API is a frame - vkBegin, draws, vkEnd - and pipelines, which are
// made from SPIR-V.
//
// Shaders are SPIR-V, as Vulkan itself requires. Nothing here compiles
// GLSL: that keeps the package small and changes nothing about speed,
// since the driver compiles SPIR-V to the GPU's own code either way.
// Write GLSL and compile it with glslc from the Vulkan SDK, or with any
// other tool that writes SPIR-V, then load the .spv with bytes.read.
// cube.vl beside this file carries its two shaders inline, so it runs
// with nothing installed.
//
// Every Vulkan function used is declared pub below and called directly
// from vulkan-1.dll, which ships with every current GPU driver. The VK
// struct holds the raw handles, so anything this package does not wrap
// can be done with the same calls a C program makes.
//
// Needs Veyl 0.66.0 or newer, for win.handle. Windows only for now.
//
// Textures, uniform buffers and push constants are there, and a
// resizable window (win.resizable) rebuilds the swapchain by itself.
// Not done yet: index buffers, compute, and validation layers.

// ---- structures, laid out as vulkan_core.h has them ----

pub extern struct VkApplicationInfo {
    sType: u32
    pNext: ptr
    pApplicationName: ptr
    applicationVersion: u32
    pEngineName: ptr
    engineVersion: u32
