    out: ptr) -> int from "vulkan-1"
pub extern fn vkDestroySurfaceKHR(inst: ptr, surface: ptr, alloc: ptr) from "vulkan-1"
pub extern fn vkGetPhysicalDeviceSurfaceSupportKHR(pd: ptr, family: int, surface: ptr,
    out: ptr) -> int from "vulkan-1"
pub extern fn vkGetPhysicalDeviceSurfaceCapabilitiesKHR(pd: ptr, surface: ptr,
    out: VkSurfaceCapabilitiesKHR) -> int from "vulkan-1"
pub extern fn vkGetPhysicalDeviceSurfaceFormatsKHR(pd: ptr, surface: ptr, count: ptr,
    out: ptr) -> int from "vulkan-1"
