// ---- the functions, from vulkan-1.dll ----
//
// Handles and pointers are ptr; counts, flags and enums are int, of
// which the driver reads the low 32 bits. Results are VkResult: 0 is
// success, a negative number an error.

pub extern fn vkCreateInstance(info: VkInstanceCreateInfo, alloc: ptr, out: ptr) -> int from "vulkan-1"
pub extern fn vkDestroyInstance(inst: ptr, alloc: ptr) from "vulkan-1"
pub extern fn vkEnumeratePhysicalDevices(inst: ptr, count: ptr, out: ptr) -> int from "vulkan-1"
pub extern fn vkGetPhysicalDeviceProperties(pd: ptr, out: ptr) from "vulkan-1"
