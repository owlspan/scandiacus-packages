// gl - OpenGL on a win window.
//
//     veyl get gl
//
//     import "gl"
//
//     let w = must(win.open("cube", 800, 600))
//     let g = must(glOpen(w))
//     while win.poll(w) {
//         glClearColor(0.1, 0.1, 0.15, 1.0)
//         glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT)
//         ...
//         glSwap(g)
//     }
//     glClose(g)
//
// The window is an ordinary win window, so win.poll, win.pressed,
// win.mouseX and the rest of the input functions keep working. What
// changes is the drawing: win.present is not called, glSwap shows the
// frame instead, and the win.* drawing functions are not used on a
// window with a context.
//
// glOpen asks for a context the old way, through wglCreateContext,
// which every Windows driver answers with the newest compatibility
// profile it has - OpenGL 4.6 on current AMD, NVIDIA and Intel drivers.
// So shaders, buffers, vertex arrays and framebuffers are all there,
// and so are the old fixed-function calls. glVersion() says what was
// given.
//
// Needs Veyl 0.66.0 or newer, for win.handle. Windows only for now; on
// Linux and macOS glOpen fails rather than guessing.
//
// The OpenGL 1.1 calls are the real functions, declared with extern, so
// their float parameters are C floats: a literal passes as it is, a
// float variable needs f32(x), as in glClearColor(f32(r), 0.0, 0.0, 1.0).
// Everything built on mem.call below takes plain int and float.
//
// How the calls get made. opengl32.dll exports only OpenGL 1.1; every
// later function is a pointer the driver hands out once a context is
// current. The 1.1 calls are declared with extern below. The rest are
// looked up by glOpen into the vars further down and called through
// mem.call. mem.call passes a float as a double, which is wrong for a
// GLfloat parameter, so the float-taking calls go through their
// pointer forms (glUniform1f is glUniform1fv on a one-float buffer).
//
// The function pointers live in globals, so one program has one set.
// They belong to the context that was current when glOpen ran; two
// contexts on the same driver give the same pointers, which is what
// every OpenGL loader relies on.

// ---- Windows ----

extern struct GLPixelFormat {
    size: u16
    version: u16
    flags: u32
    pixelType: u8
    colorBits: u8
    alphaBits: u8 at 18
    depthBits: u8 at 23
    stencilBits: u8 at 24
    damageMask: u32 at 36
}

extern fn GetDC(hwnd: ptr) -> ptr from "user32"
extern fn ReleaseDC(hwnd: ptr, dc: ptr) -> int from "user32"
extern fn ChoosePixelFormat(dc: ptr, pfd: GLPixelFormat) -> int from "gdi32"
extern fn SetPixelFormat(dc: ptr, format: int, pfd: GLPixelFormat) -> bool from "gdi32"
extern fn SwapBuffers(dc: ptr) -> bool from "gdi32"
extern fn wglCreateContext(dc: ptr) -> ptr from "opengl32"
extern fn wglMakeCurrent(dc: ptr, rc: ptr) -> bool from "opengl32"
extern fn wglDeleteContext(rc: ptr) -> bool from "opengl32"
extern fn wglGetProcAddress(name: str) -> ptr from "opengl32"

// ---- OpenGL 1.1, straight from opengl32.dll ----

pub extern fn glClear(mask: int) from "opengl32"
pub extern fn glClearColor(r: f32, g: f32, b: f32, a: f32) from "opengl32"
pub extern fn glClearDepth(d: float) from "opengl32"
pub extern fn glViewport(x: int, y: int, w: int, h: int) from "opengl32"
pub extern fn glScissor(x: int, y: int, w: int, h: int) from "opengl32"
pub extern fn glEnable(cap: int) from "opengl32"
