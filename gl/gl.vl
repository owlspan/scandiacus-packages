pub extern fn glFrontFace(mode: int) from "opengl32"
pub extern fn glPolygonMode(face: int, mode: int) from "opengl32"
pub extern fn glLineWidth(w: f32) from "opengl32"
pub extern fn glPointSize(s: f32) from "opengl32"
pub extern fn glDrawArrays(mode: int, first: int, count: int) from "opengl32"
pub extern fn glDrawElements(mode: int, count: int, kind: int, offset: ptr) from "opengl32"
pub extern fn glGetError() -> int from "opengl32"
pub extern fn glGetIntegerv(name: int, out: *i32) from "opengl32"
pub extern fn glFlush() from "opengl32"
pub extern fn glFinish() from "opengl32"
pub extern fn glGenTextures(n: int, out: *u32) from "opengl32"
